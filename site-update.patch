+.rs-g span{display:block;margin-top:3px;font-size:10px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--s)}
+
+/* Openings table */
+.sp-open{width:100%;border-collapse:collapse;margin:0 0 2.75rem;font-size:.95rem;border-top:2px solid var(--navy)}
+.sp-open th{text-align:left;font-weight:700;color:var(--ink);padding:.7rem .75rem .7rem 0;border-bottom:1px solid var(--rule)}
