+.d-lm{--ac:#7a6aa8}.d-ll{--ac:#2a9187}.d-3d{--ac:#1f3a5f}.d-rc{--ac:#4a7fb8}.d-uw{--ac:#2f7fa8}
+
+/* Filter and citation note */
+.dt-tools{margin:1.9rem 0 1.5rem;padding:1rem 0 1.1rem;border-top:2px solid var(--navy);border-bottom:1px solid var(--rule)}
