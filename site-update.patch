+/* Position tiles */
+
+.rs-glance{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:0 0 34px;position:relative;z-index:2}
+.rs-g{display:block;background:#fff;border-radius:10px;padding:14px 6px 12px;text-align:center;box-shadow:0 4px 14px rgba(0,0,0,.12);border-top:3px solid var(--c);text-decoration:none!important;transition:transform .15s ease,box-shadow .15s ease}
