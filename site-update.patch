+.dt-chip i{width:.6rem;height:.6rem;border-radius:50%;background:var(--ac)}
+.dt-chip span{font-weight:400;opacity:.7}
+.dt-chip:hover{border-color:var(--navy)}
+.dt-chip.on{background:var(--navy);border-color:var(--navy);color:#fff}
+.dt-chip.on[data-f]:not([data-f="all"]){background:var(--ac);border-color:var(--ac)}
+.dt-chip.on i{background:#fff}
+.dt-cite{display:flex;gap:.6rem;align-items:baseline;margin:.9rem 0 0;font-size:.9rem;font-style:italic;color:var(--muted)}
+.dt-cite i{font-size:.8rem;color:var(--teal)}
+
+/* Cards: one column, text only */
+.dt-grid{display:grid;grid-template-columns:1fr;gap:1.25rem}
+.dt-card{border:1px solid var(--rule);border-radius:14px;background:var(--bg);box-shadow:0 14px 30px -26px rgba(31,58,95,.6)}
+
+.dt-body{display:flex;flex-direction:column;padding:1.2rem 1.4rem 1.3rem}
