+
+/* Page */
+.tc{--ink:#1c2733;--text:#3d4752;--muted:#6b7480;--rule:#dfe3e8;--wash:#f3f5f8;--bg:#fff;--navy:#1f3a5f;--teal:#2a8c83;--gold:#9a7413;--gold-bg:#fbf4dc;color:var(--text)}
+.tc ul{list-style:none;margin:0;padding:0}
+.tc li{margin:0}
+.tc a{color:var(--navy);text-decoration:none;border-bottom:0}
+.tc a:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
+.tc h2{font-size:1.7rem;line-height:1.2;color:var(--ink);margin:0;padding:0}
+.tc-kicker{margin:0 0 .25rem;font:700 .78rem 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--teal)}
+
+/* Area colours */
+.a-cv{--ac:#1f3a5f}.a-ml{--ac:#2a9187}.a-pg{--ac:#4a7fb8}.a-sy{--ac:#b8901c}.a-rp{--ac:#7a6aa8}
+
+/* Recognition */
+.tc-hon{display:flex;align-items:center;gap:1rem;margin:1.75rem 0 0;padding:1rem 1.25rem;border-radius:12px;background:var(--gold-bg);border:1px solid rgba(184,144,28,.28)}
+.tc-hon-i{flex:0 0 2.6rem;height:2.6rem;border-radius:50%;background:#b8901c;color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.15rem}
+.tc-hon p{margin:0;line-height:1.45}
+.tc-hon b{display:block;color:var(--ink);font-size:1.02rem}
+.tc-hon p span{display:block;font-size:.88rem;color:var(--muted)}
+
+/* Teaching areas */
+.tc-areas{margin-top:2.75rem}
+.tc-areas h2{margin-bottom:1rem}
+.tc-bar{display:flex;gap:4px;height:12px;margin:0 0 1.25rem}
+.tc-bar span{background:var(--ac);border-radius:6px}
+.tc-arl{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:1rem}
+.tc-ar{display:flex;gap:.9rem;align-items:flex-start;padding:1.1rem 1.1rem 1rem;border:1px solid var(--rule);border-radius:12px;background:linear-gradient(180deg,color-mix(in srgb,var(--ac) 7%,var(--bg)),var(--bg) 70%)}
+.tc-ai{flex:0 0 2.5rem;height:2.5rem;border-radius:10px;background:var(--ac);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.05rem}
+.tc-an{margin:0;font:400 .82rem 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
+.tc-an b{font-size:1.35rem;letter-spacing:0;color:var(--ac);margin-right:.2rem}
+.tc-ar h3{margin:.15rem 0 .55rem;font:700 1rem/1.35 'PT Serif',Georgia,serif;color:var(--ink)}
+.tc-au{margin:0;display:flex;flex-wrap:wrap;gap:.3rem}
+.tc-au span{font:700 .72rem/1 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.03em;color:var(--ac);background:color-mix(in srgb,var(--ac) 10%,var(--bg));border-radius:4px;padding:.3rem .42rem}
+
+/* Teaching history by role */
+.tr-hist-h{margin-top:3.25rem}
+.tr-chips{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:1rem}
+.tr-chip{display:inline-flex;align-items:center;gap:.45rem;font:700 .88rem/1 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.03em;color:var(--text);background:none;border:1px solid var(--rule);border-radius:999px;padding:.48rem .85rem;cursor:pointer}
+.tr-chip i{width:.6rem;height:.6rem;border-radius:50%;background:var(--ac)}
+.tr-chip:hover{border-color:var(--navy)}
+.tr-chip.on{background:var(--navy);border-color:var(--navy);color:#fff}
+.tr-chip.on[data-f]:not([data-f="all"]){background:var(--ac);border-color:var(--ac)}
+.tr-chip.on i{background:#fff}
+.tr-chip:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
+.tc [hidden]{display:none!important}
+.tr-roles{position:relative;margin-top:1.75rem;padding-left:2.25rem}
+.tr-roles:before{content:"";position:absolute;left:.55rem;top:.6rem;bottom:1.5rem;width:2px;background:linear-gradient(180deg,var(--k-cur,#3fb8ad),var(--rule) 30%)}
+.tr-role{position:relative;padding:0 0 2.5rem}
+.tr-node{position:absolute;left:-2.25rem;top:.35rem;width:1.15rem;height:1.15rem;border-radius:50%;background:var(--bg);border:3px solid var(--navy)}
+.tr-role.is-current .tr-node{border-color:#2e7d4f;box-shadow:0 0 0 4px color-mix(in srgb,#2e7d4f 18%,transparent)}
+.tr-rh{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1rem}
+.tr-kick{margin:0 0 .2rem;font:700 .8rem 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--navy)}
+.tr-role.is-current .tr-kick{color:#2e7d4f}
+.tr-rh h2{font:700 1.4rem/1.25 'PT Serif',Georgia,serif;color:var(--ink);margin:0}
+.tr-meta{margin:.35rem 0 0;font-size:.92rem;line-height:1.5;color:var(--muted)}
+.tr-cnt{flex:0 0 auto;margin:0;text-align:center;font:400 .72rem 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:.45rem .7rem;border:1px solid var(--rule);border-radius:10px}
+.tr-cnt b{display:block;font-size:1.35rem;letter-spacing:0;color:var(--navy);line-height:1.1}
+.tr-units{display:grid;grid-template-columns:repeat(auto-fill,minmax(15.5rem,1fr));gap:.85rem}
+.tr-u{display:flex;flex-direction:column;padding:.85rem 1rem .9rem;border:1px solid var(--rule);border-top:3px solid var(--ac);border-radius:10px;background:var(--bg)}
+.tr-top{display:flex;justify-content:space-between;align-items:center;gap:.5rem}
+.tr-code{font:700 .9rem 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.04em;color:var(--ac)}
+.tr-inst{font:700 .7rem 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.06em;color:var(--muted);background:var(--wash);border-radius:4px;padding:.2rem .45rem}
+.tr-u h3{margin:.35rem 0 .25rem;font:700 1rem/1.35 'PT Serif',Georgia,serif;color:var(--ink)}
+.tr-alt{margin:0 0 .25rem;font-size:.8rem;font-style:italic;color:var(--muted)}
+.tr-terms{display:flex;flex-wrap:wrap;gap:.35rem;margin:auto 0 0;padding-top:.6rem}
+.tr-terms span{font:700 .76rem/1 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.03em;white-space:nowrap;color:var(--ac);background:color-mix(in srgb,var(--ac) 12%,var(--bg));border:1px solid color-mix(in srgb,var(--ac) 30%,transparent);border-radius:999px;padding:.32rem .65rem}
+.tr-note{margin:.9rem 0 0;font-size:.9rem;font-style:italic;color:var(--muted)}
+.tr-empty{margin:1rem 0 0;padding:1rem 1.25rem;background:var(--wash);border-radius:8px}
+
+@media only screen and (max-width:37.5em){
+  .tr-roles{padding-left:1.6rem}
+  .tr-roles:before{left:.35rem}
+  .tr-node{left:-1.6rem;width:1rem;height:1rem}
+  .tr-rh h2{font-size:1.2rem}
+  .tr-chips{flex-wrap:nowrap;overflow-x:auto;max-width:100%;padding-bottom:.25rem}
+  .tr-chip{white-space:nowrap}
+}
diff --git a/assets/css/pages/viail.css b/assets/css/pages/viail.css
new file mode 100644
index 0000000..886f2e1
--- /dev/null
+++ b/assets/css/pages/viail.css
@@ -0,0 +1,102 @@
+html{scroll-behavior:smooth}
+@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
+
+/* Top banner and figure tiles (same style as the other pages) */
+.vl-hero{position:relative;overflow:hidden;color:#fff;border-radius:14px;padding:40px;background:linear-gradient(135deg,#1f3a5f 0%,#2f5d94 62%,#3fb8ad 100%)}
+.vl-hero:before{content:"";position:absolute;right:-50px;top:-70px;width:230px;height:230px;border-radius:50%;background:rgba(255,255,255,.07)}
+.vl-hero:after{content:"";position:absolute;right:110px;bottom:-70px;width:150px;height:150px;border-radius:50%;background:rgba(255,255,255,.05)}
+.vl-hero>*{position:relative}
+.vl-over{font-size:12px;letter-spacing:2.5px;text-transform:uppercase;opacity:.75;margin:0 0 8px}
+.vl .vl-hero h1{color:#fff;font-size:32px;margin:0 0 10px;padding:0;line-height:1.2}
+.vl-hero p.s{margin:0;font-size:15.5px;opacity:.92;max-width:600px;line-height:1.6}
+
+/* VIAIL banner extras */
+
+.vl-hero{display:flex;align-items:center;justify-content:space-between;gap:1.5rem}
+.vl-ht{flex:1;min-width:0}
+.vl .vl-hero h1{font-size:60px;line-height:1;letter-spacing:.14em;margin:0 0 10px}
+.vl-full{margin:0 0 12px!important;font-size:1.05rem;letter-spacing:.02em;opacity:.95}
+.vl-full b{color:#9ff0e6}
+.vl-emb{flex:0 0 170px;width:170px;height:170px}
+
+/* Page */
+.vl{--ink:#1c2733;--text:#3d4752;--muted:#6b7480;--rule:#dfe3e8;--wash:#f3f5f8;--bg:#fff;--navy:#1f3a5f;--teal:#2a8c83;color:var(--text)}
+.vl ul,.vl ol{list-style:none;margin:0;padding:0}
+.vl li{margin:0}
+.vl a{text-decoration:none;border-bottom:0}
+.vl a:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
+.vl-sec{margin-top:3.25rem;scroll-margin-top:1rem}
+.vl-kicker{margin:0 0 .25rem;font:700 .78rem 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--teal)}
+.vl h2{margin:0 0 1.25rem;padding:0;font-size:1.75rem;line-height:1.2;color:var(--ink)}
+.vl h2:after{content:"";display:block;width:56px;height:3px;margin-top:.6rem;border-radius:2px;background:linear-gradient(90deg,#1f3a5f,#3fb8ad)}
+.vl-lead{font-size:1.08rem;line-height:1.7;margin:0 0 1.25rem;max-width:42em}
+
+/* Mission */
+.vl-pillars{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
+.vl-pl{display:flex;gap:1rem;padding:1.25rem;border:1px solid var(--rule);border-radius:14px;background:linear-gradient(160deg,var(--wash),var(--bg) 65%)}
+.vl-pli{flex:0 0 2.8rem;height:2.8rem;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.15rem;background:linear-gradient(135deg,#1f3a5f,#2f5d94 60%,#3fb8ad)}
+.vl-pl h3{margin:.1rem 0 .3rem;font:700 1.08rem 'PT Serif',Georgia,serif;color:var(--ink)}
+.vl-pl p{margin:0;font-size:.95rem;line-height:1.6}
+
+/* Name */
+.vl-name{display:grid;grid-template-columns:1.15fr 1fr;gap:1rem}
+.vl-nc{padding:1.4rem 1.5rem;border:1px solid var(--rule);border-radius:14px;background:var(--bg)}
+.vl-nc h3{margin:0 0 1rem;font:700 .82rem 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
+.vl-acr{display:grid;grid-template-columns:1fr 1fr 2.3fr 1fr;gap:.6rem}
+.vl-acr span{min-width:0;text-align:center;padding:.75rem .4rem .65rem;border-radius:12px;background:var(--wash)}
+.vl-acr b{display:block;font:700 2.1rem/1 'PT Sans Narrow','Arial Narrow',sans-serif;color:var(--navy)}
+.vl-acr em{display:block;margin-top:.35rem;font-style:normal;font-size:.82rem;color:var(--muted)}
+.vl-acr .ai{background:linear-gradient(135deg,#1f3a5f,#2f5d94 60%,#3fb8ad)}
+.vl-acr .ai b,.vl-acr .ai em{color:#fff}
+.vl-acr .l{opacity:.6}
+.vl-cap{margin:1rem 0 0;font-size:.92rem;line-height:1.6;color:var(--text)}
+.vl-ps{background:linear-gradient(160deg,var(--wash),var(--bg) 70%)}
+.vl-ps .vl-ar{margin:0 0 .4rem;font:700 3rem/1.25 'Noto Naskh Arabic','Scheherazade New','Geeza Pro','Times New Roman',serif;color:var(--navy);text-align:left}
+.vl-ps p{margin:0;font-size:.95rem;line-height:1.6}
+
+/* Themes */
+.vl-themes{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}
+.vl-th{padding:1.15rem 1.2rem;border:1px solid var(--rule);border-top:3px solid var(--ac);border-radius:12px;background:var(--bg)}
+.vl-ti{display:inline-flex;align-items:center;justify-content:center;width:2.3rem;height:2.3rem;border-radius:10px;background:color-mix(in srgb,var(--ac) 12%,var(--bg));color:var(--ac);font-size:1rem}
+.vl-th h3{margin:.7rem 0 .3rem;font:700 1.05rem 'PT Serif',Georgia,serif;color:var(--ink)}
+.vl-th p{margin:0;font-size:.9rem;line-height:1.55;color:var(--text)}
+
+/* Members and visitors */
+.vl-vp .pp-ini{font-family:'PT Serif',Georgia,serif;font-weight:700;font-size:30px;fill:#fff;letter-spacing:1px}
+.vl-ppl{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem}
+.vl-ppl>div{scroll-margin-top:1rem}
+.vl-vis li{display:flex;align-items:center;gap:.8rem;padding:.75rem 0;border-bottom:1px solid var(--rule)}
+.vl-vis li:first-child{border-top:1px solid var(--rule)}
+.vl-vp{flex:0 0 2.6rem;width:2.6rem;height:2.6rem;border-radius:50%}
+.vl-vy{margin:0!important;font:700 .72rem 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.08em;color:var(--teal)}
+.vl-vis h4{margin:.05rem 0;font:700 .98rem 'PT Serif',Georgia,serif;color:var(--ink)}
+.vl-vis p{margin:0;font-size:.85rem;color:var(--muted)}
+
+/* Join */
+.vl-join{margin:3.5rem 0 1rem;position:relative;overflow:hidden;color:#fff;border-radius:16px;padding:2rem 2.25rem;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.25rem;background:linear-gradient(135deg,#1f3a5f 0%,#2f5d94 62%,#3fb8ad 100%)}
+.vl-join:before{content:"";position:absolute;right:-60px;top:-90px;width:240px;height:240px;border-radius:50%;background:rgba(255,255,255,.07)}
+.vl-join>*{position:relative}
+.vl-join>div:first-child{flex:1 1 22rem}
+.vl-join h2{color:#fff;margin:0 0 .35rem;font-size:1.55rem}
+.vl-join h2:after{display:none}
+.vl-join p{margin:0;opacity:.92;line-height:1.6}
+.vl-jb{display:flex;flex-wrap:wrap;gap:.6rem}
+.vl-btn{display:inline-flex;align-items:center;gap:.45rem;background:#fff;color:#1f3a5f!important;font-weight:700;padding:.75rem 1.25rem;border-radius:8px}
+.vl-btn:hover{background:#eef3f8}
+.vl-btn.alt{background:transparent;color:#fff!important;border:1px solid rgba(255,255,255,.6)}
+.vl-btn.alt:hover{background:rgba(255,255,255,.12)}
+.vl-btn:focus-visible{outline:2px solid #fff;outline-offset:3px}
+
+@media only screen and (max-width:52em){
+  .vl-themes{grid-template-columns:repeat(2,1fr)}
+  .vl-name,.vl-ppl{grid-template-columns:1fr}
+}
+@media only screen and (max-width:37.5em){
+  .vl-hero{padding:28px 22px}.vl .vl-hero h1{font-size:44px}
+  .vl-emb{display:none}
+  .vl-acr b{font-size:1.7rem}
+  .vl-acr em{font-size:.72rem}
+  .vl h2{font-size:1.45rem}
+  .vl-pillars,.vl-themes{grid-template-columns:1fr}
+  .vl-join{padding:1.6rem 1.4rem}
+}
