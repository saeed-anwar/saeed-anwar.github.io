+.dt-lk:hover{border-color:var(--navy)}
+.dt-lk.pri{background:var(--navy);border-color:var(--navy);color:#fff!important}
+.dt-lk.pri:hover{background:#2f5d94}
+.dt-bt[aria-expanded="true"]{background:var(--ink);border-color:var(--ink);color:#fff!important}
+.dt-bib{position:relative;margin-top:.6rem}
+.dt-bib pre{margin:0;padding:.85rem 1rem;max-height:14rem;overflow:auto;background:var(--wash);border:1px solid var(--rule);border-radius:8px;font:.74rem/1.55 Menlo,Consolas,'Courier New',monospace;color:var(--ink);white-space:pre}
+.dt-copy{position:absolute;top:.5rem;right:.5rem;font:700 .75rem 'PT Sans Narrow','Arial Narrow',sans-serif;background:var(--bg);color:var(--navy);border:1px solid var(--rule);border-radius:4px;padding:.25rem .55rem;cursor:pointer}
+.dt-empty{margin:1.5rem 0 0;padding:1rem 1.25rem;background:var(--wash);border-radius:8px}
