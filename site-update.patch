+.sp-open tr.is-closed td{color:var(--muted)}
+.sp-st{display:inline-flex;align-items:center;gap:.45rem;white-space:nowrap;font-weight:700}
+.sp-st:before{content:"";width:.55rem;height:.55rem;border-radius:50%;background:var(--open)}
+.sp-st.open{color:var(--open)}
+.sp-st.closed{color:var(--closed)}.sp-st.closed:before{background:var(--closed)}
+.sp-when{display:block;font-size:.85rem;color:var(--muted);margin-top:.15rem}
+.sp-routes dd.sp-rs{margin:0 0 .45rem;font-size:.9rem;color:var(--muted)}
+.sp-routes dd.sp-rs .sp-st{margin-right:.35rem}
+
+/* Position sections */
+.sp-sec{padding:1.75rem 0 1.5rem;border-top:1px solid var(--rule)}
+.sp-sec.is-closed h2,.sp-sec.is-closed p{color:var(--muted)}
+.sp-sec ul{margin:.25rem 0 1rem 1.2rem}
+.sp-routes{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;margin:1.25rem 0 1rem}
+.sp-routes dt{font-weight:700;color:var(--ink);margin:0 0 .3rem}
+.sp-routes dd{margin:0;font-size:.95rem}
