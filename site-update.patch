+.dt-desc{margin:0;font-size:.93rem;line-height:1.6;color:var(--text);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
+.dt-desc.open{display:block;-webkit-line-clamp:unset}
+.dt-more{align-self:flex-start;margin:.3rem 0 0;padding:0;background:none;border:0;font:700 .85rem 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.03em;color:var(--teal);cursor:pointer}
+.dt-paper{margin:.85rem 0 0;padding-top:.75rem;border-top:1px dashed var(--rule);font-size:.85rem;line-height:1.5;color:var(--muted)}
+.dt-paper span{display:block;font:700 .72rem 'PT Sans Narrow','Arial Narrow',sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:.15rem}
+.dt-paper em{display:block;font-style:italic;color:var(--ink);font-size:.92rem}
+.dt-links{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:auto;padding-top:.85rem}
